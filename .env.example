# Required (the server refuses to boot without these)
DATABASE_URL=postgres://intake:intake@localhost:5433/intake
ANTHROPIC_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
ADMIN_GITHUB_LOGIN=
SESSION_SECRET=change-me-to-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:8788

# Optional (defaults shown)
PORT=8788
INTAKE_MODEL=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
GITHUB_API_BASE=https://api.github.com
GITHUB_OAUTH_BASE=https://github.com
PROMPTS_DIR=prompts
CONSOLE_DIST=console/dist
WIDGET_DIST=widget/dist
TRUST_PROXY=false
RUST_LOG=info,tower_http=info
