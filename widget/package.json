{
  "name": "@intake/widget",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node mock/server.mjs",
    "build": "vite build && vite build -c vite.veilkit.config.ts",
    "build:veilkit": "OUT=$PWD/vendor/veilkit && cd ${VEILKIT_DIR:-../../veilkit}/crates/veilkit-wasm && wasm-pack build --release --target web --out-dir \"$OUT\" --out-name veilkit && rm -f \"$OUT/.gitignore\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test e2e mock",
    "test": "vitest run && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build && node --test \"e2e/*.test.mjs\"",
    "size": "node --test e2e/size.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
