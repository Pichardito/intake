  "query": "select id, title, summary, status, github_issue_url\n           from tickets\n           where site_id = $1 and id <> $4 and status in ('draft', 'approved', 'merged')\n             and fts @@ to_tsquery('english', $2)\n           order by ts_rank(fts, to_tsquery('english', $2)) desc, id desc\n           limit $3",
